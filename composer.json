{
    "name": "fatjon-lleshi/antares-framework",
    "description": "Antares framework monorepo",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "fatjon-lleshi/antares": "*",
        "fatjon-lleshi/antares-validation": "*",
        "fatjon-lleshi/antares-container": "*",
        "fatjon-lleshi/antares-router": "*",
        "fatjon-lleshi/antares-monolog-bridge": "*",
        "fatjon-lleshi/antares-eloquent-bridge": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symplify/monorepo-builder": "^11.2",
        "phpstan/phpstan": "^2.0"
    },
    "repositories": [
        {"type": "path", "url": "packages/core", "options": {"symlink": true, "versions": {"fatjon-lleshi/antares": "0.1.x-dev"}}},
        {"type": "path", "url": "packages/validation", "options": {"symlink": true, "versions": {"fatjon-lleshi/antares-validation": "0.1.x-dev"}}},
        {"type": "path", "url": "packages/container", "options": {"symlink": true, "versions": {"fatjon-lleshi/antares-container": "0.1.x-dev"}}},
        {"type": "path", "url": "packages/router", "options": {"symlink": true, "versions": {"fatjon-lleshi/antares-router": "0.1.x-dev"}}},
        {"type": "path", "url": "packages/bridges/monolog", "options": {"symlink": true, "versions": {"fatjon-lleshi/antares-monolog-bridge": "0.1.x-dev"}}},
        {"type": "path", "url": "packages/bridges/eloquent", "options": {"symlink": true, "versions": {"fatjon-lleshi/antares-eloquent-bridge": "0.1.x-dev"}}}
    ],
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
