{
    "name": "fatjon-lleshi/antares-framework",
    "description": "Antares framework monorepo",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symplify/monorepo-builder": "^11.2",
        "phpstan/phpstan": "^2.0"
    },
    "repositories": [
        {"type": "path", "url": "packages/core"},
        {"type": "path", "url": "packages/validation"},
        {"type": "path", "url": "packages/container"},
        {"type": "path", "url": "packages/router"},
        {"type": "path", "url": "packages/bridges/monolog"},
        {"type": "path", "url": "packages/bridges/eloquent"}
    ],
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}