#!/usr/bin/env php
<?php

// Composer's vendor/bin proxy tells us where the project's autoloader is.
// Otherwise fall back to the package's own vendor/ (standalone checkout)
// or the vendor/ dir this package is installed in.
$autoload = $GLOBALS['_composer_autoload_path']
    ?? (file_exists(__DIR__ . '/../vendor/autoload.php')
        ? __DIR__ . '/../vendor/autoload.php'
        : __DIR__ . '/../../../autoload.php');

require_once $autoload;

use Antares\Console\Kernel;

// Commands run from the project root, so load its .env the same way the app does:
// variables already set in the real environment are not overwritten.
$projectRoot = getcwd();
\Dotenv\Dotenv::createImmutable($projectRoot)->safeLoad();

// Commands read $_ENV, which PHP usually leaves empty (variables_order = "GPCS"),
// and Dotenv skips variables that already exist. Copy the real environment in,
// so `DB_HOST=... vendor/bin/antares migrate` works and wins over .env.
$_ENV = getenv() + $_ENV;
$_ENV['APP_BASE_PATH'] ??= $projectRoot;

$kernel = new Kernel();
$kernel->handle($argv);
